# Copie este arquivo para .env na VPS e nunca envie o .env real ao Git.

# Somente o hostname, sem https://, barra ou caminho.
# O Compose deriva automaticamente:
#   frontend/API: https://DOMINIO
#   LiveKit:      wss://DOMINIO/livekit
APP_DOMAIN=nexplay.example.com

# Gere com: openssl rand -hex 24
INVITE_TOKEN=substitua-por-um-convite-aleatorio

# Gere com: openssl rand -hex 32
SESSION_SECRET=substitua-por-um-segredo-de-sessao-aleatorio

# Gere com: openssl rand -hex 16
LIVEKIT_API_KEY=substitua-por-uma-chave-aleatoria

# Gere com: openssl rand -hex 32
LIVEKIT_API_SECRET=substitua-por-um-segredo-livekit-aleatorio

# Formato: id:Nome:Descrição, com os canais separados por vírgula.
VOICE_CHANNELS=geral:Geral:Conversa livre,jogos:Jogos:Partidas e squads,afk:AFK:Pausa rápida

# Credenciais do MinIO (storage de objetos, usado só pra anexos de mensagem).
# Nunca fica exposto à internet — só o container `api` acessa, pela rede
# interna do Compose. Gere com: openssl rand -hex 20
MINIO_ROOT_USER=substitua-por-um-usuario-aleatorio
MINIO_ROOT_PASSWORD=substitua-por-uma-senha-aleatoria-com-pelo-menos-8-caracteres

# Verificação de idade/identidade (KYC). 'none' desativa o recurso inteiro — nenhuma
# verificação é exigida e a tela de verificação nem aparece. Defina um vendor (e as
# credenciais dele) só depois de contratar um serviço real de verificação de identidade.
KYC_VENDOR=none
KYC_API_KEY=
KYC_API_BASE_URL=
# Gere com: openssl rand -hex 24
KYC_WEBHOOK_SECRET=substitua-por-um-segredo-aleatorio
# Com um vendor configurado: true faz o servidor mutar automaticamente a câmera/tela de quem
# não verificou (ver README). Deixe false pra manter a verificação disponível mas opcional.
IDENTITY_VERIFICATION_REQUIRED=false
