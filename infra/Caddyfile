{$APP_DOMAIN} {
  encode zstd gzip

  # Log de acesso em arquivo (só este site, não o labstudio) pra o fail2ban
  # do host ler e banir no firewall quem fizer flood — mais seguro que rodar
  # um plugin de rate limit de terceiros dentro do próprio Caddy, que é o
  # único ponto de entrada de todo o tráfego (web+API+LiveKit).
  log {
    output file /var/log/caddy/access.log {
      roll_size 50MiB
      roll_keep 5
      roll_keep_for 168h
    }
    format json
  }

  @api path /api/*
  handle @api {
    reverse_proxy api:3000
  }

  # O SDK acrescenta /rtc ao caminho base. handle_path remove /livekit
  # antes de encaminhar /rtc ao endpoint de sinalização do LiveKit.
  handle_path /livekit/* {
    reverse_proxy livekit:7880
  }

  handle {
    reverse_proxy web:80
  }

  header {
    -Server
    X-Content-Type-Options nosniff
    Referrer-Policy no-referrer
    Permissions-Policy "camera=(self), microphone=(self), display-capture=(self)"
  }
}

labstudio.147-93-11-201.sslip.io {
  encode zstd gzip
  reverse_proxy 172.18.0.1:3001

  header {
    -Server
    X-Content-Type-Options nosniff
    Referrer-Policy strict-origin-when-cross-origin
  }
}
